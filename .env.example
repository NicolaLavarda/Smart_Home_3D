# Configurazione Connessione Home Assistant
# Strategia a cascata: Tailscale (Remoto) -> Rete Locale (LAN) -> Fallback mDNS (.local)

# 1. Indirizzo Remoto / VPN Tailscale (PRIORITARIO)
# Consente l'accesso sia da remoto sia da casa tramite rete Tailscale sicura
# Esempio: http://100.x.y.z:8123 oppure http://nome-host.tailnet.ts.net:8123
VITE_HA_TAILSCALE_URL=http://100.x.y.z:8123

# 2. Indirizzo Locale LAN (FALLBACK SECONDARIO)
# Utilizzato se Tailscale non è attivo o se sei connesso direttamente alla rete Wi-Fi/LAN di casa
# Esempio: http://192.168.1.xxx:8123 oppure ws://192.168.1.xxx:8123/api/websocket
VITE_HA_LOCAL_URL=http://192.168.1.xxx:8123

# Nota: per retrocompatibilità puoi anche definire solo VITE_HA_URL
# VITE_HA_URL=http://100.x.y.z:8123

# 3. Long-Lived Access Token generato dal tuo profilo utente in Home Assistant
VITE_HA_TOKEN=


# ============================================================================
# 4. STREAMING VIDEO LIVE (go2rtc Nativo Windows 10 - Zero Docker)
# ============================================================================
VITE_GO2RTC_URL=http://localhost:1984
GO2RTC_API_PORT=1984
GO2RTC_WEBRTC_PORT=8555
VITE_GO2RTC_TAILSCALE_URL=http://VITE_HA_TAILSCALE_URL:1984

# Credenziali Telecamera Reolink RLC-540A (Cam_Carraio)
REOLINK_CARRAIO_IP=
REOLINK_CARRAIO_USER=
REOLINK_CARRAIO_PASS=


# ============================================================================
# 5. MICROSERVIZIO SPAZIALE PYTHON (FastAPI + OpenVINO + SQLite3 WAL)
# ============================================================================
VITE_SPATIAL_SERVER_URL=http://localhost:8765
VITE_SPATIAL_WS_URL=ws://localhost:8765/ws/spatial
SPATIAL_SERVER_HOST=0.0.0.0
SPATIAL_SERVER_PORT=8765

# Modalità ingestione CV: "synthetic" | "openvino" | "mqtt" | "hybrid"
CV_INGESTION_MODE=openvino
OPENVINO_DEVICE=AUTO
OPENVINO_MODEL_NAME=yolov8n
OPENVINO_FPS_LIMIT=7.0
OPENVINO_CONF_THRESHOLD=0.35
SPATIAL_RETENTION_DAYS=30
SPATIAL_PERSIST_MIN_DISPLACEMENT_M=0.15
SPATIAL_PERSIST_HEARTBEAT_S=10.0

# Broker MQTT Mosquitto (su VM Home Assistant)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_PREFIX=frigate