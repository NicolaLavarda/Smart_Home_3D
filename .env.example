# Configurazione Home Assistant (OAuth2 in Produzione / Token in Sviluppo)
# ============================================================================
#
# PRODUZIONE (PC Fisso + Caddy + Tailscale Serve):
#   - Il frontend usa Home Assistant OAuth2 PKCE (getAuth) su porta :8443.
#   - NON impostare VITE_HA_TOKEN in .env di produzione: Vite incorpora tutte
#     le variabili VITE_* in chiaro dentro dist/assets/*.js durante "npm run build"!
#
# 1. URL HTTPS pubblico di Home Assistant per OAuth2 browser (Tailscale Serve :8443 -> VM HA)
#    Se lasciato vuoto in produzione su dominio *.ts.net, il frontend risolve
#    automaticamente https://<hostname>:8443.
#    Esempio: VITE_HA_PUBLIC_URL=https://<pc-fisso>.<tailnet>.ts.net:8443
VITE_HA_PUBLIC_URL=

# 2. Indirizzo Locale LAN di Home Assistant (usato da spatial_server per verificare token OAuth2 e snapshot)
#    Esempio: http://192.168.86.24:8123
VITE_HA_LOCAL_URL=

# 3. Indirizzo Remoto / VPN Tailscale diretto verso HA (opzionale, usato come fallback server-side o in dev)
#    Esempio: http://100.x.y.z:8123 oppure http://homeassistant.<tailnet>.ts.net:8123
VITE_HA_TAILSCALE_URL=

# Nota: per retrocompatibilità in sviluppo/script tools/*.mjs puoi usare anche VITE_HA_URL
# VITE_HA_URL=http://192.168.86.24:8123

# 4. Long-Lived Access Token — DEVE RESTARE VUOTO IN PRODUZIONE!
#    In produzione gli utenti si autenticano via OAuth2 (cookie HttpOnly sh3d_session).
#    In sviluppo locale ("npm run dev"), impostalo SOLO in .env.local (non committato su Git).
#    (Se serve un token solo lato backend Python senza esporlo al bundle Vite, usa HA_TOKEN= in alternativa.)
VITE_HA_TOKEN=


# ============================================================================
# 5. STREAMING VIDEO LIVE (go2rtc Nativo Windows 10 - Zero Docker)
# ============================================================================
# In produzione Caddy espone /go2rtc/api/webrtc* e /go2rtc/api/ws* sullo stesso
# dominio HTTPS (:443) protetti da forward_auth, mentre go2rtc resta in ascolto
# solo su 127.0.0.1:1984 (API) e 127.0.0.1:8554 (RTSP).

# Candidati WebRTC pubblicizzati da go2rtc sulla porta :8555 (TCP/UDP)
# Formato obbligatorio: <IP>:<PORTA> (es. 192.168.86.50:8555 e 100.x.y.z:8555)
# Esempio LAN:       GO2RTC_CANDIDATE_LAN=192.168.86.50:8555
# Esempio Tailscale: GO2RTC_CANDIDATE_TAILSCALE=100.x.y.z:8555
GO2RTC_CANDIDATE_LAN=
GO2RTC_CANDIDATE_TAILSCALE=

# Porte informative di go2rtc (allineate a go2rtc/go2rtc.yaml)
GO2RTC_API_PORT=1984
GO2RTC_WEBRTC_PORT=8555

# [SOLO SVILUPPO - LASCIARE COMMENTATE PER "npm run build"!]
# In produzione il frontend usa automaticamente same-origin (${origin}/go2rtc).
# Decommentarle in .env durante "npm run dev" se necessario, oppure usare .env.local:
# VITE_GO2RTC_URL=http://localhost:1984
# VITE_GO2RTC_TAILSCALE_URL=http://100.x.y.z:1984

# Credenziali Telecamera Reolink RLC-540A (Cam_Carraio)
# Variabile canonica: REOLINK_CARRAIO_PASS
# (Alias legacy supportato da scripts/start_services.bat e install_windows_services.ps1: REOLINK_CARRAIO_PASSWORD)
REOLINK_CARRAIO_IP=
REOLINK_CARRAIO_USER=
REOLINK_CARRAIO_PASS=

# Credenziali Telecamera Reolink RLC-810A (Cam_Portico)
# Imposta in .env: REOLINK_PORTICO_IP=192.168.86.51, REOLINK_PORTICO_USER=<utente>, REOLINK_PORTICO_PASS=<password>
REOLINK_PORTICO_IP=
REOLINK_PORTICO_USER=
REOLINK_PORTICO_PASS=

# Credenziali Telecamera Panoramica 180° Reolink Duo 3 PoE (Cam_Ingresso)
# Imposta in .env: REOLINK_INGRESSO_IP=192.168.86.53, REOLINK_INGRESSO_USER=<utente>, REOLINK_INGRESSO_PASS=<password>
REOLINK_INGRESSO_IP=
REOLINK_INGRESSO_USER=
REOLINK_INGRESSO_PASS=


# ============================================================================
# 6. MICROSERVIZIO SPAZIALE PYTHON (FastAPI + OpenVINO + SQLite3 WAL)
# ============================================================================
# In produzione spatial_server deve restare in ascolto SOLO su loopback (127.0.0.1),
# esposto esternamente esclusivamente tramite reverse proxy Caddy (:8080 -> :443).
SPATIAL_SERVER_HOST=127.0.0.1
SPATIAL_SERVER_PORT=8765

# Sicurezza Backend, SSO Home Assistant & CORS
# In produzione mantenere SPATIAL_AUTH_REQUIRED=true (impostare false solo per test pipeline offline)
SPATIAL_AUTH_REQUIRED=true

# Chiave segreta HMAC-SHA256 (>= 32 byte random hex o base64) per firmare il cookie HttpOnly sh3d_session.
# Se lasciata vuota, viene generata in memoria all'avvio (invalida le sessioni ad ogni riavvio).
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SPATIAL_SESSION_SECRET=

# Origini consentite per CORS (lista separata da virgole).
# Esempio produzione + test locale:
# SPATIAL_ALLOWED_ORIGINS=https://<pc-fisso>.<tailnet>.ts.net,http://localhost:3000,http://127.0.0.1:3000
SPATIAL_ALLOWED_ORIGINS=

# [SOLO SVILUPPO - LASCIARE COMMENTATE PER "npm run build"!]
# In produzione il frontend usa automaticamente same-origin (/api/v1/* e wss://<host>/ws/spatial).
# Se lasciate attive durante "npm run build", Vite può incorporare http://localhost:8765 nel bundle dist/.
# VITE_SPATIAL_SERVER_URL=http://localhost:8765
# VITE_SPATIAL_WS_URL=ws://localhost:8765/ws/spatial

# Modalità ingestione CV: "synthetic" | "openvino" | "mqtt" | "hybrid"
CV_INGESTION_MODE=openvino
OPENVINO_DEVICE=AUTO
OPENVINO_MODEL_NAME=yolov8n
OPENVINO_FPS_LIMIT=7.0
OPENVINO_CONF_THRESHOLD=0.35
# Override opzionale stream RTSP multi-camera per OpenVINO (se omesso legge automaticamente tutte le camere reali da scene_manifest.json)
# OPENVINO_CAMERA_STREAMS=Cam_Carraio=rtsp://127.0.0.1:8554/carraio_sub,Cam_Portico=rtsp://127.0.0.1:8554/portico_sub,Cam_Ingresso=rtsp://127.0.0.1:8554/ingresso_sub
SPATIAL_RETENTION_DAYS=30
SPATIAL_PERSIST_MIN_DISPLACEMENT_M=0.15
SPATIAL_PERSIST_HEARTBEAT_S=10.0

# Broker MQTT Mosquitto (su VM Home Assistant)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_PREFIX=frigate
