# Configurazione Connessione Home Assistant
# Strategia a cascata: Tailscale (Remoto) -> Rete Locale (LAN) -> Fallback mDNS (.local)

# 1. Indirizzo Remoto / VPN Tailscale (PRIORITARIO)
# Consente l'accesso sia da remoto sia da casa tramite rete Tailscale sicura
# Esempio: http://100.x.y.z:8123 oppure http://nome-host.tailnet.ts.net:8123
VITE_HA_TAILSCALE_URL=http://100.x.y.z:8123

# 2. Indirizzo Locale LAN (FALLBACK SECONDARIO)
# Utilizzato se Tailscale non è attivo o se sei connesso direttamente alla rete Wi-Fi/LAN di casa
# Esempio: http://192.168.1.xxx:8123 oppure ws://192.168.1.xxx:8123/api/websocket
VITE_HA_LOCAL_URL=http://192.168.1.xxx:8123

# Nota: per retrocompatibilità puoi anche definire solo VITE_HA_URL
# VITE_HA_URL=http://100.x.y.z:8123

# 3. Long-Lived Access Token generato dal tuo profilo utente in Home Assistant
VITE_HA_TOKEN=your_long_lived_access_token_here

