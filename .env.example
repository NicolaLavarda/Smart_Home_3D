# ============================================================================
# 0. INTERRUTTORE UNICO: MODALITÀ SVILUPPO (true) vs PRODUZIONE (false)
# ============================================================================
# Lascia compilate tutte le variabili di produzione e sviluppo qui sotto e
# cambia SOLO questo flag:
#   - false (DEFAULT SICURO — PC Fisso produzione): auth obbligatoria, CORS
#     ristretto a SPATIAL_ALLOWED_ORIGINS, same-origin Caddy/Tailscale, e
#     tutte le variabili dev (VITE_GO2RTC_URL, VITE_SPATIAL_*, VITE_HA_TOKEN,
#     VITE_HA_DEV_URL, SPATIAL_DEV_AUTH_REQUIRED) ignorate/azzerate.
#   - true (Portatile sviluppo locale): aggiunge automaticamente localhost:3000
#     /5173/8080 a CORS, abilita gli URL dev in `npm run dev` e gli override *_DEV.
#   (Nota: `npm run build` azzera comunque SEMPRE token e URL dev per sicurezza.)
SH3D_DEV_MODE=false

# ============================================================================
# 1. Configurazione Home Assistant (OAuth2 in Produzione / Dev override opzionale)
# ============================================================================
#
# PRODUZIONE (PC Fisso + Caddy + Tailscale Serve):
#   - Il frontend usa Home Assistant OAuth2 PKCE (getAuth) su porta :8443.
#   - NON impostare VITE_HA_TOKEN in .env di produzione: Vite lo azzera comunque
#     in `npm run build` e quando SH3D_DEV_MODE=false.
#
# 1. URL HTTPS pubblico di Home Assistant per OAuth2 browser (Tailscale Serve :8443 -> VM HA)
#    Se lasciato vuoto in produzione su dominio *.ts.net, il frontend risolve
#    automaticamente https://<hostname>:8443.
#    Esempio: VITE_HA_PUBLIC_URL=https://<pc-fisso>.<tailnet>.ts.net:8443
VITE_HA_PUBLIC_URL=

# 1b. [SOLO SVILUPPO — usato solo se SH3D_DEV_MODE=true] URL HA usato in `npm run dev`
#     Permette di tenere compilato VITE_HA_PUBLIC_URL per la produzione senza modificarlo.
#     Esempio: http://192.168.86.24:8123 oppure http://100.x.y.z:8123
VITE_HA_DEV_URL=

# 2. Indirizzo Locale LAN di Home Assistant (usato da spatial_server per verificare token OAuth2 e snapshot)
VITE_HA_LOCAL_URL=

# 3. Indirizzo Remoto / VPN Tailscale diretto verso HA (opzionale, usato come fallback server-side o in dev)
#    Esempio: http://100.x.y.z:8123 oppure http://homeassistant.<tailnet>.ts.net:8123
VITE_HA_TAILSCALE_URL=

# 4. Long-Lived Access Token Frontend — DEVE RESTARE VUOTO IN PRODUZIONE!
#    In produzione gli utenti si autenticano via OAuth2 (cookie HttpOnly sh3d_session).
#    Usato solo in sviluppo locale (`npm run dev` + `SH3D_DEV_MODE=true`); azzerato in build.
VITE_HA_TOKEN=

# 4b. Token Backend-Only H24 per spatial_server (MAI con prefisso VITE_, mai compilato nel JS!)
#     Consente ad AutomationEngineService, notifiche push, TTS/TV e discovery entità HA di
#     funzionare 24/7 anche con tutti i browser chiusi.
HA_TOKEN=
HA_BRIDGE_ENABLED=true
HA_MQTT_BRIDGE_ENABLED=false
# URL HTTPS pubblico della PWA Smart Home 3D (es. https://<pc-fisso>.<tailnet>.ts.net)
# Se vuoto, viene derivato automaticamente da SPATIAL_ALLOWED_ORIGINS / VITE_HA_PUBLIC_URL.
SPATIAL_PUBLIC_URL=


# ============================================================================
# 5. STREAMING VIDEO LIVE (go2rtc Nativo Windows 10 - Zero Docker)
# ============================================================================
# In produzione Caddy espone /go2rtc/api/webrtc* e /go2rtc/api/ws* sullo stesso
# dominio HTTPS (:443) protetti da forward_auth, mentre go2rtc resta in ascolto
# solo su 127.0.0.1:1984 (API) e 127.0.0.1:8554 (RTSP).

# Candidati WebRTC pubblicizzati da go2rtc sulla porta :8555 (TCP/UDP)
# Formato obbligatorio: <IP>:<PORTA> (es. 192.168.x.x:8555 e 100.x.y.z:8555)
# Esempio LAN:       GO2RTC_CANDIDATE_LAN=192.168.x.x:8555
# Esempio Tailscale: GO2RTC_CANDIDATE_TAILSCALE=100.x.y.z:8555
GO2RTC_CANDIDATE_LAN=
GO2RTC_CANDIDATE_TAILSCALE=

# Porte informative di go2rtc (allineate a go2rtc/go2rtc.yaml)
GO2RTC_API_PORT=1984
GO2RTC_WEBRTC_PORT=8555

# [SOLO SVILUPPO — attive solo con SH3D_DEV_MODE=true in `npm run dev`, azzerate automaticamente in prod/build]
VITE_GO2RTC_URL=http://localhost:1984
VITE_GO2RTC_TAILSCALE_URL=


# Credenziali Telecamera Reolink RLC-540A (Carraio)
REOLINK_CARRAIO_IP=
REOLINK_CARRAIO_USER=
REOLINK_CARRAIO_PASS=

# Credenziali Telecamera Reolink RLC-810A (Portico)
REOLINK_PORTICO_IP=
REOLINK_PORTICO_USER=
REOLINK_PORTICO_PASS=

# Credenziali Telecamera Reolink DUO V3 (Ingresso)
REOLINK_INGRESSO_IP=
REOLINK_INGRESSO_USER=
REOLINK_INGRESSO_PASS=

# Credenziali Telecamera Reolink DUO V3 (Stradina)
REOLINK_STRADINA_IP=
REOLINK_STRADINA_USER=
REOLINK_STRADINA_PASS=


# ============================================================================
# 6. MICROSERVIZIO SPAZIALE PYTHON (FastAPI + OpenVINO + SQLite3 WAL)
# ============================================================================
# In produzione spatial_server deve restare in ascolto SOLO su loopback (127.0.0.1),
# esposto esternamente esclusivamente tramite reverse proxy Caddy (:8080 -> :443).
SPATIAL_SERVER_HOST=127.0.0.1
SPATIAL_SERVER_PORT=8765

# Sicurezza Backend, SSO Home Assistant & CORS
# In produzione (SH3D_DEV_MODE=false) mantenere SPATIAL_AUTH_REQUIRED=true.
SPATIAL_AUTH_REQUIRED=true

# [SOLO SVILUPPO — applicata solo se SH3D_DEV_MODE=true, ignorata in produzione]
# Imposta false per test locali senza login HA, oppure lascia vuoto / true per usare OAuth2 reale anche in dev.
SPATIAL_DEV_AUTH_REQUIRED=

# Chiave segreta HMAC-SHA256 (>= 32 byte random hex o base64) per firmare il cookie HttpOnly sh3d_session.
# Se lasciata vuota, viene generata in memoria all'avvio (invalida le sessioni ad ogni riavvio).
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SPATIAL_SESSION_SECRET=

# Origini consentite per CORS in produzione (lista separata da virgole).
# Con SH3D_DEV_MODE=true le origini localhost:3000/5173/8080 vengono aggiunte automaticamente.
# Esempio produzione:
# SPATIAL_ALLOWED_ORIGINS=https://<pc-fisso>.<tailnet>.ts.net
SPATIAL_ALLOWED_ORIGINS=

# [SOLO SVILUPPO — attive solo con SH3D_DEV_MODE=true in `npm run dev`, azzerate automaticamente in prod/build]
VITE_SPATIAL_SERVER_URL=http://localhost:8765
VITE_SPATIAL_WS_URL=ws://localhost:8765/ws/spatial

# Modalità ingestione CV: "synthetic" | "openvino" | "mqtt" | "hybrid"
CV_INGESTION_MODE=openvino
OPENVINO_DEVICE=AUTO
OPENVINO_CPU_THREADS=2
OPENVINO_MODEL_NAME=yolov8n
OPENVINO_FPS_LIMIT=7.0
OPENVINO_CONF_THRESHOLD=0.62
# Override opzionale stream RTSP multi-camera per OpenVINO (se omesso legge automaticamente tutte le camere reali da scene_manifest.json)
# OPENVINO_CAMERA_STREAMS=Cam_Carraio=rtsp://127.0.0.1:8554/carraio_sub,Cam_Portico=rtsp://127.0.0.1:8554/portico_sub,Cam_Ingresso=rtsp://127.0.0.1:8554/ingresso_sub,Cam_Stradina=rtsp://127.0.0.1:8554/stradina_sub
SPATIAL_RETENTION_DAYS=30
SPATIAL_PERSIST_MIN_DISPLACEMENT_M=0.15
SPATIAL_PERSIST_HEARTBEAT_S=10.0

# Broker MQTT Mosquitto (su VM Home Assistant)
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_PREFIX=frigate


# ============================================================================
# 7. SOTTOSISTEMA BIOMETRICO NATIVO (Face Recognition + ALPR Targhe ONNX)
# ============================================================================
# Elaborazione asincrona dual-stream (tracking sui substream, snapshot on-demand
# ad alta risoluzione da go2rtc solo quando un track entra in range utile).
GO2RTC_HTTP_BASE_URL=http://127.0.0.1:1984
BIOMETRICS_ENABLED=true
BIOMETRICS_FACE_ENABLED=true
BIOMETRICS_ALPR_ENABLED=true
BIOMETRICS_ONNX_PROVIDER=cpu
BIOMETRICS_ONNX_INTRA_THREADS=2
BIOMETRICS_ONNX_INTER_THREADS=1
BIOMETRICS_QUEUE_MAXSIZE=8
BIOMETRICS_MIN_EVAL_INTERVAL_S=0.6
BIOMETRICS_MAX_ATTEMPTS_PER_TRACK=6
BIOMETRICS_UNKNOWN_BACKOFF_S=4.0
BIOMETRICS_SNAPSHOT_TIMEOUT_S=2.5
BIOMETRICS_PANORAMIC_MAX_WIDTH=3840
BIOMETRICS_PANORAMIC_EDGE_MARGIN_U=0.15
BIOMETRICS_FACE_DET_MODEL=det_500m.onnx
BIOMETRICS_FACE_REC_MODEL=w600k_mbf.onnx
BIOMETRICS_FACE_MIN_WIDTH_PX=48.0
BIOMETRICS_FACE_MIN_LAPLACIAN=35.0
BIOMETRICS_FACE_MAX_YAW_RATIO=0.55
BIOMETRICS_FACE_MATCH_THRESHOLD=0.45
BIOMETRICS_FACE_MARGIN_THRESHOLD=0.08
BIOMETRICS_FACE_CONSENSUS_K=2
BIOMETRICS_FACE_MAX_RANGE_M=8.0
BIOMETRICS_ALPR_DET_MODEL=yolo-v9-t-384-license-plate-end2end
BIOMETRICS_ALPR_OCR_MODEL=cct-xs-v2-global-model
BIOMETRICS_ALPR_MIN_PLATE_WIDTH_PX=55.0
BIOMETRICS_ALPR_CONSENSUS_K=2
BIOMETRICS_ALPR_MAX_RANGE_M=13.0
BIOMETRICS_ALPR_WHITELIST_MAX_DIST=1
BIOMETRICS_CROP_RETENTION_DAYS=14
BIOMETRICS_CROP_MAX_MB=250.0
#BIOMETRICS_DATA_DIR=
#BIOMETRICS_PLATES_WHITELIST_FILE=
# Override per-camera opzionale: CameraId:face=range_m,CameraId:alpr=range_m
#BIOMETRICS_CAMERA_RULES=Cam_Carraio:face=8.0,Cam_Carraio:alpr=13.0


# ============================================================================
# 8. REGISTRAZIONE NVR DUAL-TIER (Sub H24 + Main Event con Pre-Buffer RAM)
# ============================================================================
# Cartella radice su HDD CMR interno SATA (es. D:\Surveillance). Lascia vuoto se non ancora montato.
SPATIAL_NVR_STORAGE_DIR=
# Abilita il registratore nativo dual-tier (Sub continuo + Main su evento con pre-roll RAM)
SPATIAL_NVR_RECORDER_ENABLED=false
SPATIAL_NVR_SUB_SEGMENT_SEC=60.0
SPATIAL_NVR_MAIN_PRE_ROLL_SEC=10.0
SPATIAL_NVR_MAIN_INERTIA_SEC=15.0
SPATIAL_NVR_MAIN_MAX_CLIP_SEC=300.0
SPATIAL_NVR_RAM_BUFFER_MAX_MB_PER_CAM=48.0
SPATIAL_NVR_TRIGGER_CLASSES=person,car,truck,motorbike
SPATIAL_NVR_MIN_CONFIDENCE=0.55
# Retention automatica e salvaguardia spazio libero su disco (0 GB = nessun tetto fisso, usa solo min_free_gb)
SPATIAL_NVR_MAX_STORAGE_GB=0.0
SPATIAL_NVR_MIN_FREE_GB=50.0
SPATIAL_NVR_SUB_RETENTION_DAYS=30
SPATIAL_NVR_MAIN_RETENTION_DAYS=60
SPATIAL_NVR_PRUNE_INTERVAL_SEC=300.0
SPATIAL_NVR_INDEX_DB_NAME=nvr_index.db
# Calibrazione fine allineamento temporale (ms) per stream: CameraId:tier=offset_ms
#SPATIAL_NVR_CAMERA_CLOCK_OFFSETS=Cam_Carraio:sub=0,Cam_Carraio:main=-200
# Override opzionale stream RTSP per NVR (formato: CameraId=sub_url|main_url,...; se vuoto usa scene_manifest.json + go2rtc)
#SPATIAL_NVR_CAMERA_STREAMS=Cam_Carraio=rtsp://127.0.0.1:8554/carraio_sub|rtsp://127.0.0.1:8554/carraio_main


# ============================================================================
# 9. EPISODI SCENA (SceneEvent), SNAPSHOT ANNOTATI & NOTIFICHE FIRMATE
# ============================================================================
SPATIAL_EVENTS_INERTIA_S=18.0
SPATIAL_EVENTS_PRE_ROLL_S=3.0
SPATIAL_EVENTS_RETENTION_DAYS=30
SPATIAL_EVENTS_SNAPSHOT_MAX_MB=400.0
SPATIAL_EVENTS_SNAPSHOT_MAX_WIDTH=1280
SPATIAL_SIGNED_MEDIA_TTL_S=86400

