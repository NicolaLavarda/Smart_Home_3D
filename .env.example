# Configurazione WebSocket Home Assistant
# Entrambi gli URL sono validi (l'IP diretto 192.168.86.24 è consigliato su Windows per evitare ritardi di risoluzione mDNS)
VITE_HA_URL=ws://192.168.86.24:8123/api/websocket
# Alternativa: VITE_HA_URL=ws://homeassistant.local:8123/api/websocket

# Inserisci qui il tuo Long-Lived Access Token generato dal tuo profilo utente in Home Assistant
VITE_HA_TOKEN=your_long_lived_access_token_here

