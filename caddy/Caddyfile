{
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

http://:8080 {
	bind 127.0.0.1

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8765
	}

	handle /ws/spatial {
		reverse_proxy 127.0.0.1:8765
	}

	handle /go2rtc/api/webrtc* {
		route {
			forward_auth 127.0.0.1:8765 {
				uri /api/v1/auth/verify
				header_up -Connection
				header_up -Upgrade
			}
			uri strip_prefix /go2rtc
			reverse_proxy 127.0.0.1:1984
		}
	}

	handle /go2rtc/api/ws* {
		route {
			forward_auth 127.0.0.1:8765 {
				uri /api/v1/auth/verify
				header_up -Connection
				header_up -Upgrade
			}
			uri strip_prefix /go2rtc
			reverse_proxy 127.0.0.1:1984 {
				header_up -Origin
			}
		}
	}

	handle /go2rtc/* {
		respond "Forbidden" 403
	}

	handle /go2rtc {
		respond "Forbidden" 403
	}

	handle {
		root * dist
		encode zstd gzip

		@no_cache path / /index.html /sw.js /workbox-*.js /registerSW.js /manifest.webmanifest /models/scene_manifest.json
		@immutable_assets path /assets/*

		route {
			try_files {path} /index.html
			header @no_cache Cache-Control "no-cache, must-revalidate"
			header @immutable_assets Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
